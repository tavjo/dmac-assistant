# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Staged Docker build context: only build_context/plugins/ is tracked
# (plugin sources COPY'd into /app/plugins/ at image build). Everything else
# under build_context/ (e.g. docs/, vendored sync targets) stays untracked.
build_context/docs/

# Local env file for live runs
.env

# OI-3 Bedrock auth-proxy secret env (T2): holds the institutional Bedrock
# bearer token, injected into the proxy container at runtime via compose
# env_file. Never committed. The committed template is proxy-secret.env.example.
bedrock-proxy/proxy-secret.env

# Sidecar local-NExtSEEK overlays (Amendment A-2): copies of the local stack's
# db.env + nextseek.env, layered over .env for the sidecar service only while
# the E2E target is tavjo's local instance (nextseek.env interpolates
# $MYSQL_HOST/$NEXTSEEK_MYSQL_DATABASE from db.env, so both are needed, in
# stack order). Never committed.
sidecar/local-nextseek*.env

# Local Codex planning artifacts
.codex/
.claude/
CLAUDE.md
cursor/
.env.*
!.env.example
.coverage
docs/superpowers/
.playwright-mcp/
.codex/
.claude/
.cursor/
.srs/

# Per-task git worktrees
.worktrees/

# Vendored sources (host-side sync via scripts/sync-vendor-deps.sh)
vendor/

# hibayes-runtime-reliability plan: generated CSV input (T02) + run output dir (T01)
data/hibayes_eval_rows.csv
out/

# T5 — BAML codegen output (regenerated at image-build time, not committed)
tools/e2e/baml_client/

# Router BAML codegen output (regenerated by `make baml-generate`, not committed).
# Aligned 2026-05-28 with tools/e2e/baml_client/ disposition. Fresh clones must
# run `uv sync && make baml-generate` before bridge/tests can import from this
# package (used by ws.py, router/models.py, router/capabilities.py, router/agent.py
# and 7+ test files).
src/dmac_assistant/router/baml_client/

# T1 — E2E evidence artifacts (per-run; not committed)
evidence/

# general
var/
logs/


# OI-3 acceptance run artifacts: generated evidence (env dumps, ledgers, transcripts),
# regenerated per run — never commit (one historical run captured a raw NEXTSEEK password).
# Ignore the whole runs/ tree EXCEPT the two synthetic fixtures that unit tests read:
#   tests/unit/test_validate_acceptance.py         -> runs/_fixture_selftest/
#   tests/unit/test_automode_allowlist_regression  -> runs/20260615T131344Z/classifier_verdict.json
tools/oi3-acceptance/runs/
!tools/oi3-acceptance/runs/_fixture_selftest/
!tools/oi3-acceptance/runs/_fixture_selftest/**
!tools/oi3-acceptance/runs/20260615T131344Z/
tools/oi3-acceptance/runs/20260615T131344Z/*
!tools/oi3-acceptance/runs/20260615T131344Z/classifier_verdict.json
