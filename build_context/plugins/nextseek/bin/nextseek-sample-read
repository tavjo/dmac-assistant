#!/bin/sh
# nextseek-sample-read: read existing NExtSEEK sample data by UID. Read-only.
# Cannot upload, write, or start a batch upload.
set -eu
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/_nextseek_common.sh"

for arg in "$@"; do
  case "$arg" in
    --confirmed-write|--start|--upload)
      nextseek_die 3 "$arg is forbidden: this tool is read-only and cannot upload" ;;
    --help)
      echo "Usage: nextseek-sample-read --uid <UID> [--uid <UID> ...]"
      echo ""
      echo "Read existing sample data from NExtSEEK by UID (repeatable --uid flag)."
      echo "Prints a JSON array of raw JSON:API sample bodies."
      exit 0 ;;
  esac
done
exec python "$SCRIPT_DIR/_batch_upload_runner.py" sample-read "$@"
