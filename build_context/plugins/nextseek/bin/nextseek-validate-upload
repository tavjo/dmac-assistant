#!/bin/sh
# nextseek-validate-upload: read-only batch-upload validation. Calls the
# NExtSEEK batch-upload/validate/ endpoint (no INSERT). Cannot upload.
set -eu
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/_nextseek_common.sh"

ROWS=""; PROJECT_ID=""; UPDATE="false"; CHECKS="structure,name_check,dag"; OUT="${NEXTSEEK_OUTPUTS_DIR}"
MERGE=""; KNOWN=""
while [ $# -gt 0 ]; do
  case "$1" in
    --rows) ROWS="$2"; shift 2 ;;
    --project-id) PROJECT_ID="$2"; shift 2 ;;
    --update-existing) UPDATE="true"; shift ;;
    --checks) CHECKS="$2"; shift 2 ;;
    --merge-existing) MERGE="$2"; shift 2 ;;
    --known-attrs) KNOWN="$2"; shift 2 ;;
    --out) OUT="$2"; shift 2 ;;
    --confirmed-write|--start|--upload)
      nextseek_die 3 "$1 is forbidden: this tool validates only and cannot upload" ;;
    --help)
      echo "Usage: nextseek-validate-upload --rows <file.json> --project-id <int>"
      echo "       [--update-existing] [--checks c1,c2,...] [--merge-existing <file.json>]"
      echo "       [--known-attrs <file.json>] [--out <dir>]"
      echo ""
      echo "Validate rows against NExtSEEK via the read-only batch-upload/validate/ endpoint."
      echo "Prints ValidationResult JSON to stdout and writes validation_result.json under --out."
      exit 0 ;;
    *) nextseek_die 3 "unknown arg: $1" ;;
  esac
done
[ -n "$ROWS" ] || nextseek_die 3 "--rows is required"
[ -n "$PROJECT_ID" ] || nextseek_die 3 "--project-id is required"
set -- validate --rows "$ROWS" --project-id "$PROJECT_ID" --update-existing "$UPDATE" --checks "$CHECKS" --out "$OUT"
if [ -n "$MERGE" ]; then set -- "$@" --merge-existing "$MERGE"; fi
if [ -n "$KNOWN" ]; then set -- "$@" --known-attrs "$KNOWN"; fi
exec python "$SCRIPT_DIR/_batch_upload_runner.py" "$@"
