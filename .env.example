# DMAC live E2E environment template
#
# Copy the values below into your local `.env` and your home-level `~/.env`
# before running Wave 4 live tests. The pytest live fixtures read `~/.env`.
#
# These are the bridge-side variable names expected by `build_tools.verify_env`.
# The container entrypoint later aliases the NEXTSEEK_* values to the plugin's
# canonical env vars automatically.
#
# Rules that matter:
# - Do not leave any value empty.
# - `AWS_REGION` must look like `us-east-1`.
# - `NEXTSEEK_URL` must use `https://`.
# - `NEXTSEEK_URL` must contain a real dev hostname segment:
#   `dev`, `dev-*`, or `*-dev`.
# - Keep secrets on a single line with no surrounding spaces.
#
# Fake placeholder values only. Replace them in `.env` with real dev creds.

# AWS Bedrock bearer token used by Wave 4 live tests.
AWS_BEARER_TOKEN_BEDROCK=fake-bedrock-bearer-token-for-dev-only

# Concrete AWS region for the Bedrock runtime host allowlist.
AWS_REGION=us-east-1

# Bridge-side Nextseek username. The entrypoint maps this to SEEK_USER.
NEXTSEEK_USERNAME=fake-nextseek-dev-user

# Bridge-side Nextseek password. The entrypoint maps this to SEEK_PASSWORD.
NEXTSEEK_PASSWORD=fake-nextseek-dev-password

# Dev-only Nextseek base URL.
# Valid examples:
# - https://nextseek-dev.example.mit.edu
# - https://dev.nextseek.example.mit.edu
# Invalid examples:
# - http://nextseek-dev.example.mit.edu
# - https://nextseek.example.mit.edu
NEXTSEEK_URL=https://nextseek-dev.example.mit.edu

# ---------------------------------------------------------------------------
# Bridge-side variables (Wave 1 bootstrap; path-root loaders land in Wave 2).
# ---------------------------------------------------------------------------
# In-memory user map loaded by the bridge at startup.
# Shape: JSON object, {"<user_id>": {"password": "...", "projects": ["name", ...]}}.
# Keep on a single line.
DMAC_USERS={"alice": {"password": "dev-only-replace-me", "projects": ["example-project"]}}

# uvicorn bind host + port. The POC default is localhost-only.
DMAC_BRIDGE_HOST=127.0.0.1
DMAC_BRIDGE_PORT=8000
